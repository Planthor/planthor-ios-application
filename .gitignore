# Miscellaneous
*.class
*.log
*.tmp
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
release-manifest.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/local.properties

# Xcode user-specific state
**/xcuserdata/
*.xcuserstate
DerivedData/

# Environment / secrets — never commit real values
.env
.env.*
!.env.example
dart_defines/*.json
!dart_defines/*.example.json

# Local debugging output
/debug.json

# Flutter version manager — SDK checkout/cache is local
.fvm/

# AI tooling
.gemini/
.agents/mcp_config.json
